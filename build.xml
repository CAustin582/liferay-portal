<?xml version="1.0"?>

<project name="build-new">
	<property name="portal.rootdir" location="." />
	<import file="build-common.xml" />
	<target name="all" depends="clean">
		<antcall target="deploy" />
	</target>

	<macrodef name="portal-subant-target">
		<attribute name="target" />

		<sequential>
			<subant failonerror="true" target="@{target}">
				<dirset dir="${basedir}">
					<include name="portal-impl" />
					<include name="portal-service" />
					<include name="portal-test" />
					<include name="portal-test-internal" />
					<include name="portal-web" />
					<include name="modules/registry-api" />
					<include name="support-tomcat" />
					<include name="util-bridges" />
					<include name="util-java" />
					<include name="util-slf4j" />
					<include name="util-taglib" />
				</dirset>
			</subant>
		</sequential>
	</macrodef>

	<target name="clean">
		<portal-subant-target target="clean" />
	</target>

	<target name="compile">
		<portal-subant-target target="compile" />
		<!-- <antcall target="depend.all">
			<param name="target" value="compile" />
		</antcall> -->
	</target>

	<!-- <target name="deploy">
		<antcall target="depend.all">
			<param name="target" value="deploy" />
		</antcall>
	</target>

	<target name="install">
		<antcall target="depend.all">
			<param name="target" value="install" />
		</antcall>
	</target>

	<target name="jar">
		<antcall target="depend.all">
			<param name="target" value="jar" />
		</antcall>
	</target> -->
</project>