<?xml version="1.0"?>
<!DOCTYPE project>

<project name="build-app-module" xmlns:artifact="antlib:org.apache.maven.artifact.ant">
	<property file="bnd.bnd" />

	<target name="testt">
		<pathconvert property="testt" pathsep=",\${line.separator}&#x0009;">
			<path>
				<fileset dir="D:/liferay-portal/modules/apps/collaboration/dist" includes="*.jar" />
			</path>

			<globmapper from="*.jar" to="*" />
		</pathconvert>
		<echo>${testt}</echo>
		<!-- <basename file="${basedir}" property="app.name" />

		<echo>${app.name}</echo> -->
	</target>

	<target name="dist-module-artifact" depends="download-module-artifact,record-module-change-log">
	</target>

	<!-- <target name="get-module-artifact" if="${artifact.properties.exists}"> -->
	<target
		name="download-module-artifact"
		description="Download the module artifact jar from the Liferay Nexus repository."
	>
		<fail message="Missing artifact.properties file in ${basedir}.">
			<condition>
				<not>
					<available file="artifact.properties" />
				</not>
			</condition>
		</fail>

		<loadproperties srcFile="artifact.properties">
			<filterchain>
				<linecontains>
					<contains value="artifact.url=" />
				</linecontains>

				<replacestring from="https://cdn." to="http://" />
			</filterchain>
		</loadproperties>

		<get src="${artifact.url}" dest="${dist.dir}" />
	</target>

	<target
		name="get-module-change-log-ticket-list"
		depends="download-module-artifact,get-artifact-version-previous-release"
		description="Get an aggregated list of tickets from the change logs of all versions of the current module since the version present in the previous release of this app."
	>
		<!-- <loadfile property="module.change.log.ticket.list" srcfile="src/resources/META-INF/liferay-releng.changelog"> -->
		<loadfile property="module.change.log.ticket.list">
			<url url="jar:file:dist/com.liferay.blogs.api-1.0.2.jar!/META-INF/liferay-releng.changelog" />

			<filterchain>
				<tokenfilter>
					<filetokenizer />

					<replaceregex pattern="[\s\S]* Bundle Version ${p.version}" replace="" />
				</tokenfilter>

				<linecontainsregexp>
					<regexp pattern="[0-9a-f]{40}\^\.\.[0-9a-f]{40}" />
				</linecontainsregexp>

				<headfilter skip="1" />

				<tokenfilter>
					<filetokenizer />

					<replaceregex flags="g" pattern="[0-9a-f]{40}\^\.\.[0-9a-f]{40}=" replace="" />
					<replaceregex flags="g" pattern="\n|\r\n" replace=" " />
				</tokenfilter>
			</filterchain>
		</loadfile>
	</target>

	<target
		name="get-artifact-version-previous-release"
		description="Get the version of the current module that was present in the previous release of this app."
		if="${app.changelog.exists}"
	>
		<loadfile property="artifact.version.previous.release">
			<propertyresource property="artifact.versions.previous.release" />

			<filterchain>
				<tokenfilter>
					<stringtokenizer delims="," />
				</tokenfilter>

				<containsstring contains="${Bundle-SymbolicName}" />

				<!-- <linecontains>
					<contains value="${Bundle-SymbolicName}" />
				</linecontains> -->
			</filterchain>
		</loadfile>

		<echo>${artifact.version.previous.release}</echo>
	</target>

	<!-- <macrodef name="set-module-version-previous">
		<attribute name="app.version.previous" default="@{app.version.previous}" />

		<sequential>
			<property file="${app.dir}/app.changelog" />

			<property name="artifact.version.previous" value="${artifacts-@{app.version.previous}}" />
			<loadproperties name="artifact.version.previous" value="${artifacts-@{app.version.previous}}">
				<filterchain>
			</loadproperties>
		</sequential>
	</macrodef> -->

	<target
		name="record-module-change-log"
		depends="get-module-change-log-ticket-list"
		description="Record the change log tickets for the current module to app.changelog."
	>
		<!-- <property url="jar:file:dist/com.liferay.blogs.api-1.0.2.jar!/META-INF/liferay-releng.changelog" /> --><!-- 
		<loadproperties>
			<url url="jar:file:dist/com.liferay.blogs.api-1.0.2.jar!/META-INF/liferay-releng.changelog" />
		</loadproperties> -->
		<loadresource property="change.log">
			<filterchain>
			</filterchain>
			<url url="jar:file:dist/com.liferay.blogs.api-1.0.2.jar!/META-INF/liferay-releng.changelog" />
		</loadresource>

		<echo>${change.log}</echo>
	</target>
</project>