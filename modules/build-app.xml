<?xml version="1.0"?>
<!DOCTYPE project>

<project name="build-app" xmlns:artifact="antlib:org.apache.maven.artifact.ant">
	<condition property="app.changelog.exists">
		<available file="app.changelog" />
	</condition>

	<basename file="${basedir}" property="app.name" />

	<property file="${modules.dir}/../build.properties" />

	<pathconvert pathsep="," property="app.module.dirs">
		<globmapper from="${modules.dir}${file.separator}*" to="*" />

		<path>
			<dirset dir="${basedir}">
				<present targetdir="${basedir}">
					<mapper from="*" to="*/bnd.bnd" type="glob" />
				</present>
			</dirset>
		</path>
	</pathconvert>

	<pathconvert property="dist.dir">
		<dirset dir="${basedir}" includes="dist" />
	</pathconvert>

	<mkdir dir="${dist.dir}" />

	<target name="testt">
		<loadfile property="testt" srcfile="${modules.dir}/liferay-releng.changelog" />
		<fail>${testt}</fail>
		<!-- <basename file="${basedir}" property="app.name" />

		<echo>${app.name}</echo> -->
	</target>

	<target name="build-app" depends="check-stale-artifacts,dist-module-artifacts,record-module-versions" />

	<target name="check-stale-artifacts">
		<exec executable="${gradle.wrapper.path}" outputproperty="stale.artifacts">
			<arg value="printStaleArtifact" />
			<arg value="-q" />
		</exec>

		<!-- <fail if="${stale.artifacts}" message="Stale artifacts detected:{line.separator}${stale.artifacts}" /> -->
	</target>

	<target name="clean-app">
		<delete dir="${dist.dir}" />
	</target>

	<target name="dist-module-artifacts" depends="check-stale-artifacts">
		<subant target="dist-module-artifact">
			<dirset dir="${modules.dir}" excludes="${build.modules.excludes}" includes="${app.module.dirs}" />

			<property name="app.changelog.exists" value="${app.changelog.exists}" />
			<property name="app.dir" value="${basedir}" />
			<property name="dist.dir" value="${dist.dir}" />
		</subant>
	</target>

	<target name="init">
		<!-- <fail message="This target must be executed from an app suite's root directory.">
			<condition>
				<not>
					<available file="app.bnd" />
				</not>
			</condition>
		</fail> -->

		<!-- <touch file="dist/app.changelog.tickets.tmp" />
		<touch file="dist/app.module.versions.tmp" /> -->

		<!-- <echo append="true" file="app.changelog" message="#${file.separator}" />
		<echo append="true" file="app.changelog" message="# Liferay App Version ${app.version}${file.separator}" />
		<echo append="true" file="app.changelog" message="#${file.separator}" /> -->
	</target>

	<!-- <target name="record-module-versions" depends="dist-module-artifacts"> -->
	<target name="record-module-versions">
		<pathconvert property="module.versions.list" pathsep=",\${line.separator}&#x0009;">
			<flattenmapper />

			<path>
				<fileset dir="${dist.dir}" includes="*.jar" />
			</path>
		</pathconvert>

		<echo append="true" message="${line.separator}modules-${app.version}=\${line.separator}&#x0009;${module.versions.list}" />
		<!-- <echo append="true" file="app.changelog" message="${line.separator}modules-${app.version}=\${line.separator}&#x0009;${module.versions.list}" /> -->
	</target>
</project>