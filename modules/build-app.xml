	<target name="record-module-version" depends="get-module-artifact">
		<echo append="true" file="${dist.dir}/" message="" />
	</target>

	<target name="build-app" depends="check-stale-artifacts,get-module-artifacts,init">
	<!-- <target name="build-app"> -->
