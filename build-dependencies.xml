<?xml version="1.0"?>

<project name="dependencies" xmlns:artifact="antlib:org.apache.maven.artifact.ant">
	<property name="local.repo.dir" location="${user.home}/.m2/repository" />

	<macrodef name="get-artifact-jar">
		<attribute name="artifactId" />
		<attribute name="id" />

		<sequential>
			<loadresource property="@{artifactId}.groupPath">
				<propertyresource name="@{artifactId}.pom.groupId" />
				<filterchain>
					<tokenfilter>
						<replacestring from="." to="${file.separator}" />
					</tokenfilter>
				</filterchain>
			</loadresource>

			<filelist id="@{id}" dir="${local.repo.dir}">
				<file name="${@{artifactId}.groupPath}/@{artifactId}/${@{artifactId}.pom.version}/@{artifactId}-${@{artifactId}.pom.version}.${@{artifactId}.pom.packaging}" />
			</filelist>

			<pathconvert property="@{id}" refid="@{id}" />
		</sequential>
	</macrodef>

	<artifact:pom artifactId="artifact" groupId="${groupId}" version="${version}" id="artifact.pom" />

	<echo>${artifactId}</echo>
	<!-- <get-artifact-jar artifactId="${artifactId}" id="artifact.jar" />

	<available file="${artifact.jar}" property="artifact.jar.exists" />

	<uptodate property="artifact.jar.isUpToDate" targetFile="${artifact.jar}">
		<srcfiles dir="${portal.rootdir}/${artifactId}" includes="${artifactId}.jar" />
	</uptodate> -->

	<echo>
		${artifactId} - ${artifact.pom.groupId} - ${artifact.pom.version}
		${artifact.jar}
		${artifact.jar.exists}
		${artifact.jar.isUpToDate}
	</echo>

